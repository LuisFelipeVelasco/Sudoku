<!--
  ╔══════════════════════════════════════════════════════════╗
  ║  SUDOKU – Main Menu  |  Estilo Clásico / Brutalista      ║
  ║  Paleta: pergamino oscuro · acento ámbar dorado          ║
  ║  ─────────────────────────────────────────────────────── ║
  ║  Fondo base   #1e1a0f   Tierra profunda                  ║
  ║  Card tablero #2a2316   Madera oscura                    ║
  ║  Celda A      #332b1a   Pergamino sombreado              ║
  ║  Celda B      #261f10   Pergamino oscuro                 ║
  ║  Acento       #c8923a   Ámbar / oro envejecido           ║
  ║  Texto        #f0e6cc   Marfil cálido                    ║
  ║  Muted        #8a7355   Tierra media                     ║
  ║  ─────────────────────────────────────────────────────── ║
  ║  UX: Aesthetic Effect · Von Restorff · Nielsen 1–10     ║
  ╚══════════════════════════════════════════════════════════╝
-->

<Pane
        maxHeight="-Infinity" maxWidth="-Infinity"
        minHeight="-Infinity" minWidth="-Infinity"
        prefHeight="563.0" prefWidth="553.0"
        style="-fx-background-color: linear-gradient(to bottom, #1e1a0f 0%, #16120a 100%);"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.examplez.demo.controllers.MainMenuController">

   <!-- ══════════════════════════════════════════════════
        CARD del tablero  — madera oscura con borde dorado
        Aesthetic Effect: superficie que evoca calidez
        Nielsen #1: contexto visual inmediato del espacio
   ═══════════════════════════════════════════════════ -->
   <Rectangle
           layoutX="55.0" layoutY="90.0"
           width="444.0" height="328.0"
           arcWidth="6" arcHeight="6"
           style="
         -fx-fill: #2a2316;
         -fx-stroke: #c8923a;
         -fx-stroke-width: 1.5;
         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.70), 22, 0.0, 0, 6);
      "/>

   <!-- Línea interior decorativa — refuerza el marco -->
   <Rectangle
           layoutX="62.0" layoutY="97.0"
           width="430.0" height="314.0"
           arcWidth="4" arcHeight="4"
           style="
         -fx-fill: transparent;
         -fx-stroke: rgba(200,146,58,0.18);
         -fx-stroke-width: 1;
      "/>

   <!-- ══════════════════════════════════════════════════
        TÍTULO
        Von Restorff: único elemento con glow dorado cálido
        Aesthetic Effect: espaciado generoso, presencia fuerte
   ═══════════════════════════════════════════════════ -->
   <Label
           alignment="CENTER"
           layoutX="14.0" layoutY="24.0"
           prefHeight="50.0" prefWidth="523.0"
           text="SUDOKU"
           textAlignment="CENTER"
           style="
         -fx-text-fill: #f0e6cc;
         -fx-effect: dropshadow(gaussian, rgba(200,146,58,0.60), 24, 0.35, 0, 0);
      ">
      <font>
         <Font name="Arial Bold" size="34.0"/>
      </font>
   </Label>

   <!-- Ornamento: dos líneas flanqueando el título -->
   <Rectangle
           layoutX="68.0" layoutY="74.0"
           width="148.0" height="1.5"
           style="-fx-fill: linear-gradient(to right, transparent, #c8923a);"/>
   <Rectangle
           layoutX="338.0" layoutY="74.0"
           width="148.0" height="1.5"
           style="-fx-fill: linear-gradient(to left, transparent, #c8923a);"/>

